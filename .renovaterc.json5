{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Shared reusable-workflow control plane for the codelooks IaC estate. Renovate
  // (house preset) keeps the SHA-pinned third-party actions fresh via reviewed PRs —
  // this repo previously relied on manual `pinact` runs for pin bumps.
  extends: [
    // House preset — extends home-operations#2.0.0 + :timezone(Europe/London) +
    // vulnerabilityAlerts + the "dependencies" label, and pins GitHub Actions to
    // immutable commit SHAs (helpers:pinGitHubActionDigestsToSemver keeps the
    // semver tag as a comment).
    "github>LukeEvansTech/renovate-config",
  ],

  packageRules: [
    {
      // This repo is the estate's apply-pipeline supply chain, but a bump reaches a
      // consumer only through the next release tag (README, "Versioning & pinning"):
      // a merge to main ships nothing by itself. Patch and minor bumps merge on a
      // green actionlint run; automerge stays off so each diff gets a glance as it
      // lands and the release reads them together.
      matchPackageNames: ["*"],
      automerge: false,
    },
    {
      // The reusable workflows call this repository's own composite actions pinned
      // to the release tag, and the release procedure rewrites that tag by hand. A
      // SHA pin can never be kept current (the tag is cut from the merge commit,
      // which cannot carry its own SHA), so Renovate leaves these references alone.
      matchPackageNames: ["codelooks-com/terraform-workflows"],
      enabled: false,
    },
  ],

  customManagers: [
    {
      // Bump the pinned OpenTofu engine_version defaults in the reusable workflows.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        'engine_version:\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      datasourceTemplate: "github-releases",
      packageNameTemplate: "opentofu/opentofu",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
  ],
}
